# MoeKoe Siri Control - environment template
# Copy to .env and fill in. Tokens must be >= 32 bytes, random, and distinct.

WEB_HOST=0.0.0.0
WEB_PORT=8080
CONTROL_HOST=0.0.0.0
CONTROL_PORT=8200

MOEKOE_DIR=C:\path\to\MoeKoeMusic
MOEKOE_API_URL=http://127.0.0.1:6521
MOEKOE_DIST_DIR=C:\path\to\MoeKoeMusic\dist

# Replace 192.168.1.100 with the Windows host's LAN address.
WEB_ORIGINS=http://192.168.1.100:8080,http://127.0.0.1:8080,http://localhost:8080

# Bearer token for POST /api/siri/play (Siri Shortcut only).
SIRI_HTTP_TOKEN=

# WS token embedded in the hashed client script. Cannot call the HTTP API.
SIRI_WS_TOKEN=

# Optional KuGou account for automatic session recovery (Phase 5.6).
# Lives only on this Windows .env, never in the client or in logs.
# If unset, recovery returns NOT_CONFIGURED and the feature stays dormant.
KUGOU_USERNAME=
KUGOU_PASSWORD=

# Optional secret key for Cookie gate access control (e.g. 48244279).
# When set, unauthenticated visitors get 404. Visiting /enter-<GATE_SECRET> sets a permanent access cookie.
GATE_SECRET=

